# ========================================
# プライベート設定テンプレート（git 非追跡）
# ========================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
#
# .env には .env.public にない機密情報や個人固有の設定を記載します
# .env.public で定義済みの値を上書きする場合もここに記載します

# NovelAI API トークン（メール+パスワードログインの代わりに使用可）
# NOVELAI_API_TOKEN=pst-...

# 運営形態: single（既定。自分 1 人で使う）/ multi（1 つのサーバーを複数人で使う）
# multi では上の NOVELAI_API_TOKEN を使わない（他の人のリクエストを自分のアカウント・Anlas で処理しないため）。
# 画面でログインしていないリクエストは 401 になる。single / multi 以外の値ではサーバーが起動しない。
# 計画は docs/multi_user_plan_jp.md
# APP_MODE=single
#
# multi で要るもの(single では使わない):
# - APP_MASTER_KEY: 利用者のトークンなどを暗号化する鍵(32 バイトの base64)。無いと起動しない。変えると招待も
#   利用者も見分けられなくなるので、作ったら控えておく。作り方:
#     python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# - 使える人は scripts/manage_users.py で招待する(招待した人だけがログインできる)
# - APP_ALLOWED_ORIGINS: 画面を別の配信元から開くときだけ、その配信元(カンマ区切り)。バックエンドが画面も配る
#   (Docker)なら要らない。開発中(npm run dev)は画面(:5173)から :8000 へ直接送る呼び出しがあるので、
#   開く名前ごとに書く(例: http://localhost:5173,http://novelai.lan:5173)
# APP_MASTER_KEY=
# APP_ALLOWED_ORIGINS=https://app.example.com

# テスト用 NovelAI アカウント認証情報（実アカウントの Anlas 残高確認などに使用）
# NOVELAI_TEST_EMAIL=your_email@example.com
# NOVELAI_TEST_PASSWORD=your_password

# ========================================
# vLLM サーバー設定（AI アシスタント機能）
# ========================================
# GPU 1枚構成: 両方を同じ URL に向ける（Qwen2-VL はテキスト+ビジョン両対応）
# GPU 2枚構成: それぞれ別ポートの vLLM インスタンスに向ける

# テキスト生成モデル（プロンプト整形・キャラ設定・物語ドラフト・シーンのタグ付け等）
#
# 思考モード付きモデル（qwen3 系など）は避けること。実機で qwen3-vl:2b を使ったところ、
# 日本語入力に対して思考（message.thinking）を延々と出し続けて答え（message.content）に
# 到達せず、シーンのタグ付けが1件も成立しなかった。think:false も /no_think も効かず、
# num_ctx 8192 / 出力6144トークンまで広げても終わらない。英語入力では成功するため、
# 日本語の作品を扱うなら思考モードを持たないモデルを選ぶ。
# qwen2.5:7b（Q4で約4.7GB、VRAM 8GBに収まる）では同じ入力が20秒・8/8件で成功した。
#
# Ollama を使う場合の例:
# VLLM_BASE_URL=http://localhost:11434/v1
# VLLM_MODEL=qwen2.5:7b
#
# vLLM を使う場合の例:
# VLLM_BASE_URL=http://localhost:8001/v1
# VLLM_MODEL=Qwen/Qwen2-VL-7B-Instruct

# ビジョンモデル（リバースプロンプト）
# GPU 1枚の場合はテキストと同じ URL を設定
# VLLM_VISION_BASE_URL=http://localhost:8001/v1
# VLLM_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# ========================================
# うごイラ: 動画モデルで動かす(リモートの GPU の ComfyUI)
# ========================================
# Colab・GCP で起動した ComfyUI(+ scripts/comfy_auth_proxy.py)の URL と合言葉。docs/video_remote_jp.md を参照。
# VIDEO_GEN_BASE_URL=https://xxxx-xxxx.trycloudflare.com
# VIDEO_GEN_TOKEN=
# ワークフローを差し替えるとき(任意。既定は assets/comfyui/ の Wan 2.2)
# VIDEO_GEN_WORKFLOW_LOOP=assets/comfyui/wan22_loop_api.json
# VIDEO_GEN_WORKFLOW_I2V=assets/comfyui/wan22_i2v_api.json
# VIDEO_GEN_WORKFLOW_END=assets/comfyui/wan22_end_api.json

# Hugging Face トークン（Docker Compose でのモデルダウンロードに使用）
# HF_TOKEN=hf_...

# ========================================
# 処理終了のブラウザ通知（Web Push）
# ========================================
# 通知はブラウザのプッシュサービス（Chrome なら Google）経由で届き、中身は暗号化される。
# 鍵は初回に data/vapid_private.pem として自動で作られる。設定しなくても動く。
# スマホから LAN の IP で開くときの設定は docs/notifications_jp.md を参照。
# PUSH_CONTACT=mailto:you@example.com     # プッシュサービスに伝える連絡先
# PUSH_MIN_SECONDS=15                      # これより早く終わった処理は通知しない
